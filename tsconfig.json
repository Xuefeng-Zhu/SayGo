{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@saygo/contracts": ["packages/contracts/src/index.ts"],
      "@saygo/domain": ["packages/domain/src/index.ts"],
      "@saygo/db": ["packages/db/src/index.ts"],
      "@saygo/integrations": ["packages/integrations/src/index.ts"]
    }
  },
  "include": [
    "apps/runtime/**/*.ts",
    "apps/worker/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ],
  "exclude": ["node_modules", "apps/web", "dist"]
}
