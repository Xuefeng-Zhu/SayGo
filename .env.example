# Local fictional demo only. pnpm commands work without this file.
DATABASE_URL=postgresql://saygo:saygo_local_only@localhost:55432/saygo_demo
SAYGO_DEMO=true
SAYGO_WEB_ORIGIN=http://localhost:3100
SAYGO_RUNTIME_PORT=3101
SAYGO_TOKEN_SECRET=local-demo-secret-change-before-any-shared-host
SAYGO_STAFF_PASSWORD=harbor-demo-only
# Explicit opt-in; no provider calls in fixture mode.
SAYGO_VOICE_ENABLED=false
AWS_REGION=us-east-1
SAYGO_VOICE_MODEL=amazon.nova-2-sonic-v1:0
# Use AWS_PROFILE or the standard SDK credential chain. Never NEXT_PUBLIC credentials.
