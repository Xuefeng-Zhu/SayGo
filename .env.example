# Local app development uses the existing AWS DynamoDB table.
# Use your existing AWS_PROFILE or the standard SDK credential chain.
# Leave the endpoint empty for AWS; no Docker or Java service is needed.
DYNAMODB_ENDPOINT=
DYNAMODB_TABLE=SayGo
DYNAMODB_NAMESPACE=saygo_demo
SAYGO_DEMO=true
SAYGO_WEB_ORIGIN=http://localhost:3100
SAYGO_RUNTIME_PORT=3101
SAYGO_TOKEN_SECRET=local-demo-secret-change-before-any-shared-host
SAYGO_STAFF_PASSWORD=harbor-demo-only
# Live voice is opt-in. Fixture mode still uses AWS for database access.
SAYGO_VOICE_ENABLED=false
AWS_REGION=us-west-2
SAYGO_VOICE_MODEL=amazon.nova-2-sonic-v1:0
# Never put AWS credentials in NEXT_PUBLIC variables.
# Optional offline storage: set DYNAMODB_ENDPOINT=http://127.0.0.1:8000
# and DYNAMODB_TABLE=saygo-local, then start pnpm infra:local or pnpm infra:up.
